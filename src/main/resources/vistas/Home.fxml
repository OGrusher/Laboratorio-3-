<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="520.0" spacing="16.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ufg.aulas.controladores.HomeController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label maxWidth="Infinity" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Registro de aulas" HBox.hgrow="ALWAYS" />
            <Button onAction="#cerrarSesion" text="Cerrar sesion" />
         </children>
      </HBox>
      <GridPane hgap="12.0" vgap="12.0">
         <columnConstraints>
            <ColumnConstraints minWidth="110.0" />
            <ColumnConstraints hgrow="ALWAYS" />
         </columnConstraints>
         <children>
            <Label text="Nombre" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" promptText="Ejemplo B-204" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Edificio" GridPane.rowIndex="1" />
            <TextField fx:id="txtEdificio" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Planta" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbPlanta" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Capacidad" GridPane.rowIndex="3" />
            <TextField fx:id="txtCapacidad" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Tipo de aula" GridPane.rowIndex="4" />
            <ComboBox fx:id="cmbTipoAula" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label text="Responsable" GridPane.rowIndex="5" />
            <TextField fx:id="txtResponsable" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <Label text="Estado" GridPane.rowIndex="6" />
            <ComboBox fx:id="cmbEstado" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="6" />
         </children>
      </GridPane>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button onAction="#limpiar" text="Limpiar" />
            <Button defaultButton="true" onAction="#guardar" text="Guardar" />
         </children>
      </HBox>
   </children>
</VBox>
